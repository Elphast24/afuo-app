# ─── Express API ──────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────
# Leave empty to use embedded Postgres (PGlite), stored in DATA_DIR. No account needed.
# Set to a Neon connection string to use Neon instead:
# DATABASE_URL=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/agrimatch?sslmode=require
DATABASE_URL=
DATA_DIR=./.data

# ─── Key-value store (OTP, cooldowns, rate limits) ───
# Leave empty to use an in-process store. Set both to use Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── JWT (required in production) ─────
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── SMS ──────────────────────────────
# No SMS provider is wired up: OTP codes are written to the server log.
# SMS_PROVIDER=console

# ─── File storage ─────────────────────
# Listing images are processed with sharp and stored on local disk.
UPLOAD_DIR=./uploads

# ─── Admin dashboard ──────────────────
# The admin account is created on first start. In development the password defaults to the one in the README.
# In production ADMIN_PASSWORD is required (12+ characters) or no admin account is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Fallback while no SMS provider is connected: the web app shows the sign-in code on screen (pop-up with a disclaimer).
# auto (default) = only while there is no provider; false = never; true = always.
# Anyone could sign in as any phone number while this is on. Connect SMS, then it switches off by itself.
# EXPOSE_OTP=auto
