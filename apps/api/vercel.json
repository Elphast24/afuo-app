{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "includeFiles": "drizzle/**", "maxDuration": 30 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
